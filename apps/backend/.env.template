# Copy this file to .env and adjust values for your environment

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

MONGO_URI=mongodb://localhost:27017/bootcamp-chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis role endpoints. Local docker-compose exposes auth on 6379 and realtime on 6380.
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_CONNECT_TIMEOUT=2s
AUTH_REDIS_COMMAND_TIMEOUT=2s
AUTH_REDIS_SSL=false
REALTIME_REDIS_HOST=localhost
REALTIME_REDIS_PORT=6380
REALTIME_REDIS_PASSWORD=
REALTIME_REDIS_CONNECT_TIMEOUT=2s
REALTIME_REDIS_COMMAND_TIMEOUT=2s
REALTIME_REDIS_SSL=false
SESSION_STORE=redis
RATE_LIMIT_STORE=redis
SOCKETIO_STORE=redis
USER_PROFILE_CACHE_ENABLED=true
USER_PROFILE_CACHE_TTL=60s

# File storage. Keep local/direct-upload=false for the default development path.
FILE_STORAGE_TYPE=local
FILE_DIRECT_UPLOAD_ENABLED=false
FILE_PRESIGN_PUT_TTL=10m
FILE_PRESIGN_GET_TTL=5m
FILE_PENDING_RETENTION=24h
FILE_CLEANUP_INTERVAL=10m
FILE_CLEANUP_INITIAL_DELAY=10m
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_ENDPOINT=
S3_PATH_STYLE_ACCESS=false

PORT=5001
WS_PORT=5002

OPENAI_API_KEY=sk-...
